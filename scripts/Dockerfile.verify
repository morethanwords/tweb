FROM node@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a AS node22
FROM mcr.microsoft.com/playwright@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48
COPY --from=node22 /usr/local/bin/node /usr/local/bin/node
COPY --from=node22 /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack && corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
ENV CI=1
CMD ["pnpm", "shell:verify"]
