IMAGE=ghcr.io/OWNER/telegram-web-k
IMAGE_TAG=main
# Runtime access to the site (independent of Telegram API_ID/API_HASH).
BASIC_AUTH_USER=admin
# Run: docker run --rm -it IMAGE hash-password
# Paste the bcrypt hash in SINGLE quotes so Compose preserves dollar signs:
# BASIC_AUTH_PASSWORD_HASH='$2a$14$...'
BASIC_AUTH_PASSWORD_HASH=
# For reproducible deployment/rollback, overrides IMAGE_TAG:
# IMAGE_REF=@sha256:REPLACE_WITH_PUBLISHED_DIGEST
