{
  "name": "robochat-semantic-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "shell:typecheck": "tsc --noEmit",
    "shell:lint": "oxlint src/shell scripts tests/browser tests/companion vite.config.ts vite.companion.config.ts vitest.config.ts playwright.config.ts playwright.companion.config.ts",
    "shell:unit": "vitest run && node --test scripts/*.test.mjs",
    "shell:build": "node scripts/quickjs-assets.mjs && vite build && node scripts/check-artifact.mjs",
    "shell:serve": "node scripts/serve-artifact.mjs",
    "shell:browser": "playwright test",
    "shell:browser:quick": "playwright test --project=chromium-1280x900 --project=chromium-375x812",
    "shell:verify": "node scripts/verify.mjs",
    "shell:reference": "node scripts/build-reference.mjs",
    "semantic:build": "node scripts/quickjs-assets.mjs && node scripts/semantic-build.mjs",
    "semantic:serve": "node semantic-dist/semantic-entry.js",
    "semantic:browser": "playwright test --config playwright.companion.config.ts",
    "semantic:verify": "node scripts/semantic-verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "csstype": "3.2.3",
    "oxlint": "1.75.0",
    "sass": "1.101.3",
    "solid-js": "1.9.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.13",
    "vitest": "4.1.10",
    "typescript-browser": "npm:typescript@6.0.3",
    "quickjs-emscripten-core": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lint": "6.9.7",
    "@codemirror/language": "6.12.4",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.3.6"
  }
}
