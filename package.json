{
  "name": "offline-bot-builder-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "shell:typecheck": "tsc --noEmit",
    "shell:lint": "oxlint src/shell scripts tests/browser vite.config.ts vitest.config.ts playwright.config.ts",
    "shell:unit": "vitest run && node --test scripts/*.test.mjs",
    "shell:build": "vite build && node scripts/check-artifact.mjs",
    "shell:serve": "node scripts/serve-artifact.mjs",
    "shell:browser": "playwright test",
    "shell:verify": "node scripts/verify.mjs",
    "shell:reference": "node scripts/build-reference.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "csstype": "3.2.3",
    "oxlint": "1.75.0",
    "sass": "1.101.3",
    "solid-js": "1.9.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.13",
    "vitest": "4.1.10"
  }
}
