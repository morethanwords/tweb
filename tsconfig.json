{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "solid-js": [
        "./src/vendor/solid/types/index.d.ts"
      ],
      "solid-js/web": [
        "./src/vendor/solid/web/types/index.d.ts"
      ],
      "solid-js/store": [
        "./src/vendor/solid/store/types/index.d.ts"
      ],
      "solid-js/jsx-runtime": [
        "./src/vendor/solid/types/jsx.d.ts"
      ],
      "solid-js/jsx-dev-runtime": [
        "./src/vendor/solid/types/jsx.d.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/shell/**/*.ts",
    "src/shell/**/*.tsx",
    "scripts/**/*.ts",
    "tests/browser/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reference-dist",
    "artifacts"
  ]
}
